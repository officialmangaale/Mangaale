VITE_API_BASE_URL=https://restaurant-prod.mangaale.com

# Origin of the Mangaale Food Ordering app (Next.js). Every ordering link on
# mangaale.com is built from this one value in src/config/orderApp.js.
# Must be a single origin — mixing origins splits the cart and the login session,
# which the ordering app keeps in per-origin localStorage. No trailing slash.
VITE_ORDER_APP_URL=https://food.mangaale.com
